rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dispositivo() {
      return get(/databases/$(database)/documents/dispositivi/$(request.auth.uid)).data;
    }
    function persona(chiave) {
      return get(/databases/$(database)/documents/persone/$(chiave)).data;
    }
    // Admin: questo telefono (parola segreta aperta qui) oppure la persona collegata (nome e PIN), su ogni telefono.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        || exists(/databases/$(database)/documents/admin/$(persona(dispositivo().segreto).id));
    }
    // Nome e cognome obbligatori, spazi singoli, max 60 caratteri (come profilo.js).
    function nomeValido(nome) {
      return nome is string && nome.size() <= 60 && nome.matches('^[^ ]+( [^ ]+)+$');
    }

    // Profilo: la chiave è SHA-256 di nome + PIN. Si legge solo conoscendola; l'elenco solo l'admin.
    match /persone/{chiave} {
      allow get: if request.auth != null;
      allow list, delete: if isAdmin();
      allow create: if request.auth != null
        && chiave.size() >= 20
        && nomeValido(request.resource.data.nome)
        && (
          // Iscrizione. Sostituisci CODICE-CIRCOLO SOLO nella console Firebase, mai nel repo.
          (request.resource.data.keys().hasOnly(['id', 'nome', 'codice'])
            && request.resource.data.codice == 'CODICE-CIRCOLO'
            && request.resource.data.id == request.auth.uid
            // Un dispositivo già collegato non si reiscrive: dopo un reset PIN non si riprende l'identità.
            && !exists(/databases/$(database)/documents/dispositivi/$(request.auth.uid)))
          // Reset PIN: l'admin ricrea il profilo con la nuova chiave e lo stesso id.
          || (isAdmin()
            && request.resource.data.keys().hasOnly(['id', 'nome'])
            && request.resource.data.id is string)
        );
    }

    // Collega un dispositivo (uid anonimo) a un profilo: serve la sua chiave.
    match /dispositivi/{uid} {
      allow read: if request.auth.uid == uid;
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'segreto'])
        && persona(request.resource.data.segreto).id == request.resource.data.id;
    }

    // Un documento per giorno: "create" riesce solo se il giorno è libero.
    match /turni/{data} {
      // Solo dispositivi collegati a un profilo ancora esistente (dopo un reset PIN il vecchio non legge più).
      allow read: if exists(/databases/$(database)/documents/persone/$(dispositivo().segreto));
      allow create: if data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['id', 'nome'])
        && request.resource.data.id == persona(dispositivo().segreto).id
        && request.resource.data.nome == persona(dispositivo().segreto).nome;
      // Profilo ancora esistente: dopo un reset PIN il vecchio dispositivo non cancella più.
      allow delete: if isAdmin() || resource.data.id == persona(dispositivo().segreto).id;
      // "Cerco un sostituto": il titolare mette o toglie cedo; un altro socio prende il turno che lo cerca.
      // Solo fino alle 22:00 UTC del giorno (23 d'inverno, mezzanotte d'estate): niente turni presi a posteriori.
      allow update: if request.time < timestamp.date(int(data.split('-')[0]), int(data.split('-')[1]), int(data.split('-')[2])) + duration.value(22, 'h')
        && (
          (resource.data.id == persona(dispositivo().segreto).id
            && request.resource.data.keys().hasOnly(['id', 'nome', 'cedo'])
            && request.resource.data.id == resource.data.id
            && request.resource.data.nome == resource.data.nome
            && request.resource.data.get('cedo', true) == true)
          || (resource.data.get('cedo', false) == true
            && request.resource.data.keys().hasOnly(['id', 'nome'])
            && request.resource.data.id == persona(dispositivo().segreto).id
            && request.resource.data.nome == persona(dispositivo().segreto).nome)
        );
    }

    // Promemoria: l'iscrizione alle notifiche di questo telefono. La legge solo functions/index.js (admin SDK).
    match /promemoria/{uid} {
      allow read, delete: if request.auth.uid == uid;
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'endpoint', 'p256dh', 'auth'])
        && request.resource.data.id == persona(dispositivo().segreto).id
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 1000
        && request.resource.data.endpoint.matches('^https://.+')
        && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200
        && request.resource.data.auth is string && request.resource.data.auth.size() <= 100;
    }

    // Orari e giorno di chiusura: pubblici (si vedono anche prima di entrare), li cambia solo l'admin.
    function ora(o) {
      return o == '' || (o is string && o.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    match /impostazioni/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id == 'circolo'
        && request.resource.data.keys().hasOnly(['chiusura', 'apre', 'chiude'])
        && (request.resource.data.chiusura == null || request.resource.data.chiusura in [0, 1, 2, 3, 4, 5, 6])
        && ora(request.resource.data.apre) && ora(request.resource.data.chiude);
    }

    // Storico delle azioni sui turni: lo scrive solo functions/index.js (admin SDK), lo legge solo l'admin.
    match /attivita/{id} {
      allow read: if isAdmin();
    }

    // Elenco dei soci (id → nome): lo rifà functions/index.js, lo leggono i soci, nessuno lo scrive dall'app.
    match /elenco/{id} {
      allow read: if exists(/databases/$(database)/documents/persone/$(dispositivo().segreto));
    }

    // Quante volte ogni socio apre l'app: ognuno aggiunge 1 al proprio, lo legge solo l'admin.
    // Un'apertura conta solo a 30 minuti dalla precedente contata: le ricariche (iPhone, link di WhatsApp) no.
    function accessoValido(socio, n) {
      return socio == persona(dispositivo().segreto).id
        && request.resource.data.keys().hasOnly(['n', 'ultimo'])
        && request.resource.data.n == n
        && request.resource.data.ultimo == request.time;
    }
    match /accessi/{socio} {
      allow read: if isAdmin();
      allow create: if accessoValido(socio, 1);
      allow update: if accessoValido(socio, resource.data.n + 1)
        && request.time > resource.data.ultimo + duration.value(30, 'm');
    }

    // Sostituisci CAMBIAMI con la parola segreta SOLO nella console Firebase, mai nel repo.
    // id = uid del telefono o id del profilo del socio: con la chiave giusta, solo il proprio.
    match /admin/{id} {
      allow read: if request.auth.uid == id || id == persona(dispositivo().segreto).id;
      allow create: if (request.auth.uid == id || id == persona(dispositivo().segreto).id)
        && request.resource.data.keys().hasOnly(['chiave'])
        && request.resource.data.chiave == 'CAMBIAMI';
    }
  }
}
